# Copy to .env and fill in your credentials. Do NOT commit .env.

# KMA NECIS (https://necis.kma.go.kr) account — used by external/necis-downloader to fetch waveforms.
NECIS_USER=your-id-here
NECIS_PASS=your-password-here

# Optional NECIS overrides (defaults are sensible).
# NECIS_HEADLESS=1                       # 0 to watch the browser for debugging
# NECIS_DOWNLOAD_DIR=data/necis          # staging dir for raw downloads (orchestrate overrides per-run)

# eq-cycle external deps — already installed in the user's environment; override only if needed.
# EQNET_DIR=/home/msseo/works/14.EQNet/EQNet
# EQNET_WEIGHTS=$EQNET_DIR/docs/model_phasenet_plus/model_99.pth
# SKHASH_DIR=/home/msseo/works/44.SKHASH/SKHASH/SKHASH
# HELVETICA_DIR=/home/msseo/Downloads/Helvetica
