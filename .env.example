# Copy to .env and fill in your credentials. Do NOT commit .env.
# Account / install help: see docs/INSTALL.md and docs/EXTERNAL_TOOLS.md.

# ---- Required credentials ----

# KMA NECIS (https://necis.kma.go.kr) account — used by external/necis-downloader to fetch
# waveforms. Default waveform source for clusters with events from ~2020 onwards (--source necis).
# Register at the NECIS portal (research/institutional accounts only; approval 1-5 days).
NECIS_USER=your-id-here
NECIS_PASS=your-password-here

# SNU SAC Transfer Protocol (mara.snu.ac.kr:46804) account — only required for --source stp
# or --source mixed (pre-2020 waveforms). Contact the SGTL lab at SNU for credentials.
STP_USER=your-stp-id
STP_PASS=your-stp-password

# ---- Optional overrides — only set if defaults don't work ----

# Python interpreter for pocketquake.sh. Default: whichever python3/python is on $PATH.
# POCKETQUAKE_PYTHON=/path/to/python

# STP client (Perl script). Default: stp-client.pl on $PATH. Set explicitly if it's elsewhere.
# STP_PERL_SCRIPT=/path/to/stp-client.pl
# STP_CMD="/usr/bin/perl /path/to/stp-client.pl"        # full command line (overrides STP_PERL_SCRIPT)

# NECIS browser behaviour.
# NECIS_HEADLESS=1                          # 0 to watch the browser for debugging
# NECIS_DOWNLOAD_DIR=data/necis             # staging dir (orchestrate overrides per-run)

# eq-cycle external dependencies — set only if you use the feature (see docs/EXTERNAL_TOOLS.md).
# EQNET_DIR=/path/to/EQNet                  # required for --picker phasenet_plus
# EQNET_WEIGHTS=$EQNET_DIR/docs/model_phasenet_plus/model_99.pth   # override if non-default
# SKHASH_DIR=/path/to/SKHASH/SKHASH         # required for the focal_mechanism pipeline stage
# HELVETICA_DIR=/path/to/Helvetica          # optional — falls back to DejaVu Sans

# ---- Python relocation backends (opt-in; the default Fortran chain ignores these) ----
# Pure-Python alternatives to hyp1.40 / ph2dt+hypoDD, for users without a Fortran toolchain.
# Enable with `./pocketquake.sh catalog.csv slug --python`. See docs/python_backend/README.md.
# Default backends (hypoinverse / hypodd) need none of this.

# relocDD-py (Python port of hypoDD) — required for the Python relocation backend.
# RELOCDD_PY_DIR=/path/to/relocDD-py        # clone of github.com/katie-biegel/relocDD-py (must contain run.py)

# HypoSVI + EikoNet (Stein-variational locator) — required for the Python location backend.
# HYPOSVI_DIR=/path/to/HypoSVI              # clone of the HypoSVI repo (on sys.path)
# EIKONET_DIR=/path/to/EikoNet              # clone of the EikoNet repo (HypoSVI's travel-time engine)
#
# EikoNet weights are OPTIONAL to set here: the backend auto-discovers the bundled weights
# under pipeline/velocity_models/eikonet_<velmodel>/ (fetch once with
# `python -m pipeline.core.fetch_eikonet`). Only set these to override with your own:
# HYPOSVI_EIKONET_P=/path/to/<velmodel>_eikonet_p.pt   # trained P-wave EikoNet checkpoint
# HYPOSVI_EIKONET_S=/path/to/<velmodel>_eikonet_s.pt   # trained S-wave EikoNet checkpoint
