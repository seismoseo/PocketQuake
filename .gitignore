# PocketQuake gitignore

# Credentials
.env

# Build / install artifacts
build/
dist/
*.egg-info/
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ipynb_checkpoints/

# Generated runs / data (lives under external/korea-cluster-relocation/runs/ + the cluster src_roots)
external/korea-cluster-relocation/runs/
external/korea-cluster-relocation/*/kma_waveforms/
external/korea-cluster-relocation/*/event_catalog/
external/korea-cluster-relocation/*/station_table/
external/korea-cluster-relocation/pipeline/clusters/_*generated*.py
external/korea-cluster-relocation/pipeline/notebooks/03_results_*.ipynb

# Local NECIS staging (orchestrate writes into the cluster src_root, but leave a safety net)
data/

# Jupyter
.ipynb_checkpoints/

# IDE / OS
.vscode/
.idea/
.DS_Store

# Local dev-context notes (never publish)
CLAUDE.md

# scratch run logs
*_run.log

# docs/tutorial/pocketquake_tutorial.pdf IS tracked, deliberately.
#
# It used to be ignored, with a separately hand-uploaded PocketQuake_manual.pdf tracked
# in its place. That is exactly how the published tutorial went stale: the ignored file
# was the one the build produced, the tracked file was the one docs/index.md linked to,
# and nothing kept them in step — the uploaded copy sat at v1.12.1 while the source moved
# on. Read the Docs serves this PDF straight out of docs/, so it has to be committed.
#
# When you edit the .tex, recompile before committing:
#   cd docs/tutorial && tectonic pocketquake_tutorial.tex

# MkDocs build output
site/

# Working products of local runs. These are per-user inputs and outputs, not part of
# the package: catalogs you feed in, the logs each run writes, figures you generate,
# and manually-downloaded NECIS bulk ZIPs (multi-GB). They were previously loose in
# the repo root, where they buried the ~15 tracked files and filled `git status`.
catalogs/
logs/
figures/
downloads/
*_run.log
*_augment.log
